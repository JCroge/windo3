# =====================================================
# 交易所配置
# =====================================================
EXCHANGE=okx
USE_TESTNET=false

# Binance API（使用 binance 时必需）
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# OKX API（使用 okx 时必需）
OKX_API_KEY=your_okx_api_key
OKX_SECRET=your_okx_secret
OKX_PASSWORD=your_okx_passphrase

# =====================================================
# 交易参数
# =====================================================
LEVERAGE=3
# 单笔最大保证金（USDT）— 实际下单的保证金，名义价值=margin*leverage
MAX_TRADE_AMOUNT=10.0

# =====================================================
# 风控硬限制（不可突破）
# =====================================================
# 最大回撤百分比（达到则全平+停止交易）
MAX_DRAWDOWN_PCT=20.0
# 每日最大亏损（USDT，正数。系统内部会取负作为 daily_pnl_hard_stop）
MAX_DAILY_LOSS=50.0
# 也可直接指定（负数，优先于 MAX_DAILY_LOSS）
# DAILY_PNL_HARD_STOP=-50.0
# 连续亏损 N 次熔断
CONSECUTIVE_LOSS_LIMIT=3

# 逻辑账户拆分（可选）：设为 1000 表示风控按 1000 USDT 算（不影响真实余额查询）
# 用于：实盘账户 6020 USDT，但只让其中 1000 USDT 参与风险预算计算
# 等价：max_loss 从 6020×5%=301 降到 1000×5%=50（与 MAX_DAILY_LOSS=50 对齐）
# 留空 = 用真实余额（无逻辑拆分）
# EFFECTIVE_BALANCE_CAP=1000

# =====================================================
# Agent 系统参数
# =====================================================
# 研判层运行周期（秒，默认 4h=14400）
RESEARCH_INTERVAL=14400
# 最大同时交易标的数
MAX_ACTIVE_SYMBOLS=5
# 最大并发持仓数（≤MAX_ACTIVE_SYMBOLS，控制同时开仓数量）
MAX_CONCURRENT_POSITIONS=3
# Ranking flush 窗口（秒，等待同批候选到齐后统一排序）
RANK_FLUSH_DELAY=5.0

# =====================================================
# Claude API（多 Agent 系统必需）
# =====================================================
ANTHROPIC_API_KEY=your_claude_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-4-7

# =====================================================
# Telegram 通知（可选，留空则禁用）
# =====================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =====================================================
# 市场 Regime 优化（Phase 8，全部可选，默认启用）
# =====================================================
# Regime 迟滞检测（防止 regime 边界抖动）
REGIME_HYSTERESIS_ENABLED=true
# 做空 Regime Guard（牛市中阻止弱做空信号）
SHORT_REGIME_GUARD_ENABLED=true
# 探针做空（牛市中小仓位早期反转检测）
PROBE_SHORT_ENABLED=true
# 低 R:R 多头额外槽位（牛市中允许 R:R 1.3-1.5 的多头）
LOW_RR_SLOT_ENABLED=true
# 反事实信号账本（追踪被拒信号的假设结果）
COUNTERFACTUAL_LEDGER_ENABLED=true

# R:R 动态阈值
RR_FLOOR_DEFAULT=1.5
RR_FLOOR_LONG_BULLISH=1.30
RR_FLOOR_SHORT_BULLISH=1.80

# 低 R:R 多头约束
LOW_RR_MAX_LEVERAGE=5
LOW_RR_MAX_POSITION_PCT=0.5
LOW_RR_EXTRA_SLOT=1

# 探针做空约束
PROBE_SHORT_MAX_POSITION_PCT=0.3
PROBE_SHORT_MAX_LEVERAGE=3
PROBE_SHORT_MAX_CONCURRENT=1
PROBE_SHORT_COOLDOWN_HOURS=24
